{
  "$schema": "TBOS Design System Tokens v1.0.0",
  "meta": {
    "name": "TBOS Design Tokens",
    "version": "1.1.1",
    "description": "Canonical source of truth. design-tokens.css, tailwind-theme.ts, and figma-tokens.json are generated from this file and must never diverge from it.",
    "generates": ["design-tokens.css", "tailwind-theme.ts", "figma-tokens.json"],
    "changelog": {
      "1.1.0": "Tuba Brand Identity Correction — added color.brand.{tuba-purple,tuba-coral} as first-class exact reference tokens; rebuilt color.primitive.ink around the real Tuba purple (#2A0C72) as its exact ink.600 anchor; renamed color.primitive.ember to color.primitive.coral and rebuilt it around the real Tuba coral (#F95A60) as its exact coral.500 anchor; corrected color.semantic.dark's brand-related roles (bg.brand-strong, text.on-brand, icon.on-brand, action.primary.bg-hover/bg-active) so dark-mode contrast holds against the new, darker purple. See TBOS_DESIGN_SYSTEM_V1_1_BRAND_CORRECTION_REPORT.md.",
      "1.1.1": "Danger Button Brand Correction — action.danger.bg/action.danger.bg-hover (light and dark) now resolve to color.primitive.coral.700/800 instead of color.primitive.danger.600/700 (light) and .500/.400 (dark — the latter also silently referenced an undefined danger.400 step, fixed by this change). Scope is deliberately narrow: only the two button-fill roles moved to Coral, on user instruction that destructive/danger buttons should read as Tuba's actual brand coral rather than a generic, brand-unrelated red. text.danger/border.danger/bg.danger-subtle (status badges, form-error borders, subtle fills) are unchanged and still use the Danger primitive family — status-meaning color (rejected/expired/lost) stays semantically separate from button-fill brand color, per 03_COLOR_SYSTEM.md §3's 'color is never the only signal, five-meaning system' rule. coral.700/800 were chosen (not the coral.500 brand anchor) because they are the darkest, most saturated steps in the Coral scale that hold ≥4.5:1 contrast against white button text (coral.500 itself measures ~3.15:1 — insufficient for WCAG AA normal text)."
    }
  },
  "color": {
    "brand": {
      "note": "Canonical, exact Tuba brand identity swatches — verified against the real Tuba brand source (not a tint/shade scale, not derived). Exposed as literal --tuba-purple / --tuba-coral custom properties, bypassing the standard color-{family}-{step} naming convention, because these are the fixed brand-identity reference values rather than a primitive scale. color.primitive.ink.600 and color.primitive.coral.500 are the functional scales built around these two exact anchors — see 03_COLOR_SYSTEM.md §1a.",
      "tuba-purple": "#2A0C72",
      "tuba-coral": "#F95A60"
    },
    "primitive": {
      "ink": {
        "50": "#EFEBF9", "100": "#D8CDF4", "200": "#B69DF1", "300": "#8D63EE",
        "400": "#642BE9", "500": "#4513B9", "600": "#2A0C72", "700": "#230A5C",
        "800": "#1C0949", "900": "#150836"
      },
      "coral": {
        "50": "#FCF3F3", "100": "#F9E2E2", "200": "#F7C5C7", "300": "#F7A1A4",
        "400": "#F87C80", "500": "#F95A60", "600": "#F42A31", "700": "#D41118",
        "800": "#A11217", "900": "#741114"
      },
      "copilot": {
        "50": "#F5F1FE", "100": "#E9E0FC", "200": "#D2C2F9", "300": "#B39AF2",
        "400": "#9274E8", "500": "#7654D6", "600": "#5F3EB8", "700": "#4B3193",
        "800": "#392670", "900": "#2B1D54"
      },
      "slate": {
        "0": "#FFFFFF", "50": "#F7F8FA", "100": "#EEF0F4", "200": "#E1E4EA",
        "300": "#CBD0DA", "400": "#9AA2B1", "500": "#6C7484", "600": "#4E5563",
        "700": "#383D48", "800": "#24272F", "900": "#14161B", "950": "#0B0C0F"
      },
      "success": {
        "50": "#EEFAF1", "100": "#D6F3DD", "300": "#7DD696", "500": "#2A9D4F",
        "600": "#1F7D3D", "700": "#185F2F"
      },
      "warning": {
        "50": "#FFF9E6", "100": "#FEEDB8", "300": "#FBCB4C", "500": "#E8A317",
        "600": "#B87F0E", "700": "#8C5F0A"
      },
      "danger": {
        "50": "#FDEEEE", "100": "#FAD4D4", "300": "#EF9494", "500": "#D33F3F",
        "600": "#AB2E2E", "700": "#822323"
      },
      "info": {
        "50": "#EAF6FC", "100": "#CDEBF7", "300": "#7FCBEA", "500": "#1E93C4",
        "600": "#16729A", "700": "#115774"
      }
    },
    "chart": {
      "categorical": {
        "note": "Validated per the dataviz color-formula method: fixed hue order, never cycled. Slot 1 (blue) is tuned near primitive.ink; slot 3 (violet) is primitive.copilot. Re-run scripts/validate_palette.js before altering any step.",
        "1_blue":    { "light": "#2a78d6", "dark": "#3987e5" },
        "2_orange":  { "light": "#eb6834", "dark": "#d95926" },
        "3_violet":  { "light": "#4a3aa7", "dark": "#9085e9" },
        "4_yellow":  { "light": "#eda100", "dark": "#c98500" },
        "5_magenta": { "light": "#e87ba4", "dark": "#d55181" },
        "6_green":   { "light": "#008300", "dark": "#008300" },
        "7_aqua":    { "light": "#1baf7a", "dark": "#199e70" },
        "8_red":     { "light": "#e34948", "dark": "#e66767" }
      },
      "sequentialBlue": {
        "100": "#cde2fb", "150": "#b7d3f6", "200": "#9ec5f4", "250": "#86b6ef",
        "300": "#6da7ec", "350": "#5598e7", "400": "#3987e5", "450": "#2a78d6",
        "500": "#256abf", "550": "#1c5cab", "600": "#184f95", "650": "#104281",
        "700": "#0d366b"
      },
      "diverging": { "cool": "ref:sequentialBlue", "warm": "ref:chart.categorical.8_red", "midpointLight": "#f0efec", "midpointDark": "#383835" },
      "status": {
        "good":     { "hex": "#0ca30c" },
        "warning":  { "hex": "#fab219" },
        "serious":  { "hex": "#ec835a" },
        "critical": { "hex": "#d03b3b" }
      },
      "surfaceLight": "#fcfcfb",
      "surfaceDark": "#1a1a19"
    },
    "semantic": {
      "light": {
        "bg.canvas": "{slate.50}", "bg.surface": "{slate.0}", "bg.surface-raised": "{slate.0}",
        "bg.sunken": "{slate.100}", "bg.overlay-scrim": "rgba(11,12,15,0.40)",
        "bg.brand-subtle": "{ink.50}", "bg.brand": "{ink.600}", "bg.brand-strong": "{ink.700}",
        "bg.ai-subtle": "{copilot.50}", "bg.ai": "{copilot.600}",
        "bg.success-subtle": "{success.50}", "bg.warning-subtle": "{warning.50}",
        "bg.danger-subtle": "{danger.50}", "bg.info-subtle": "{info.50}",
        "bg.disabled": "{slate.100}",
        "text.primary": "{slate.900}", "text.secondary": "{slate.600}", "text.muted": "{slate.400}",
        "text.on-brand": "{slate.0}", "text.on-ai": "{slate.0}", "text.disabled": "{slate.400}",
        "text.link": "{ink.600}", "text.brand": "{ink.600}", "text.ai": "{copilot.600}",
        "text.success": "{success.700}", "text.warning": "{warning.700}", "text.danger": "{danger.700}", "text.info": "{info.700}",
        "border.default": "{slate.200}", "border.strong": "{slate.300}", "border.brand": "{ink.500}",
        "border.focus": "{ink.500}", "border.danger": "{danger.500}",
        "icon.default": "{slate.500}", "icon.muted": "{slate.400}", "icon.on-brand": "{slate.0}",
        "action.primary.bg": "{ink.600}", "action.primary.bg-hover": "{ink.700}", "action.primary.bg-active": "{ink.800}",
        "action.secondary.bg": "{slate.0}", "action.secondary.border": "{slate.300}", "action.secondary.bg-hover": "{slate.50}",
        "action.danger.bg": "{coral.700}", "action.danger.bg-hover": "{coral.800}"
      },
      "dark": {
        "bg.canvas": "{slate.950}", "bg.surface": "{slate.900}", "bg.surface-raised": "{slate.800}",
        "bg.sunken": "{slate.950}", "bg.overlay-scrim": "rgba(0,0,0,0.60)",
        "bg.brand-subtle": "{ink.900}", "bg.brand": "{ink.500}", "bg.brand-strong": "{ink.600}",
        "bg.ai-subtle": "{copilot.900}", "bg.ai": "{copilot.500}",
        "bg.success-subtle": "rgba(42,157,79,0.16)", "bg.warning-subtle": "rgba(232,163,23,0.16)",
        "bg.danger-subtle": "rgba(211,63,63,0.16)", "bg.info-subtle": "rgba(30,147,196,0.16)",
        "bg.disabled": "{slate.800}",
        "text.primary": "{slate.50}", "text.secondary": "{slate.300}", "text.muted": "{slate.500}",
        "text.on-brand": "{slate.0}", "text.on-ai": "{slate.950}", "text.disabled": "{slate.600}",
        "text.link": "{ink.300}", "text.brand": "{ink.300}", "text.ai": "{copilot.300}",
        "text.success": "{success.300}", "text.warning": "{warning.300}", "text.danger": "{danger.300}", "text.info": "{info.300}",
        "border.default": "{slate.700}", "border.strong": "{slate.600}", "border.brand": "{ink.400}",
        "border.focus": "{ink.300}", "border.danger": "{danger.300}",
        "icon.default": "{slate.400}", "icon.muted": "{slate.500}", "icon.on-brand": "{slate.0}",
        "action.primary.bg": "{ink.500}", "action.primary.bg-hover": "{ink.600}", "action.primary.bg-active": "{ink.700}",
        "action.secondary.bg": "{slate.900}", "action.secondary.border": "{slate.600}", "action.secondary.bg-hover": "{slate.800}",
        "action.danger.bg": "{coral.700}", "action.danger.bg-hover": "{coral.800}"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "latin": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "arabic": "'Noto Sans Arabic', 'Segoe UI', system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', monospace"
    },
    "scale": {
      "display":       { "size": 32, "lineHeight": 40, "weight": 700, "letterSpacing": "-0.01em" },
      "h1":             { "size": 24, "lineHeight": 32, "weight": 700, "letterSpacing": "-0.006em" },
      "h2":             { "size": 20, "lineHeight": 28, "weight": 600, "letterSpacing": "0em" },
      "h3":             { "size": 16, "lineHeight": 24, "weight": 600, "letterSpacing": "0em" },
      "bodyLg":         { "size": 15, "lineHeight": 24, "weight": 400, "letterSpacing": "0em" },
      "body":           { "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": "0em" },
      "bodyEmphasis":   { "size": 14, "lineHeight": 20, "weight": 600, "letterSpacing": "0em" },
      "label":          { "size": 13, "lineHeight": 16, "weight": 600, "letterSpacing": "0.01em" },
      "caption":        { "size": 12, "lineHeight": 16, "weight": 400, "letterSpacing": "0.005em" },
      "micro":          { "size": 11, "lineHeight": 14, "weight": 600, "letterSpacing": "0.02em" }
    },
    "arabicLineHeightMultiplier": 1.15,
    "numericFeatures": { "table": "tabular-nums", "prose": "proportional-nums" }
  },
  "spacing": {
    "unit": 4,
    "scale": {
      "0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24,
      "8": 32, "9": 40, "10": 48, "11": 64, "12": 80, "13": 96, "14": 128
    },
    "density": {
      "comfortable": { "rowHeight": 48, "cellPaddingY": 12, "cellPaddingX": 16 },
      "compact":     { "rowHeight": 36, "cellPaddingY": 6,  "cellPaddingX": 12 }
    }
  },
  "radius": {
    "none": 0, "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "full": 9999
  },
  "border": {
    "width": { "hairline": 1, "default": 1, "thick": 2 }
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(11,15,25,0.04), 0 1px 3px rgba(11,15,25,0.06)",
    "2": "0 2px 4px rgba(11,15,25,0.04), 0 4px 8px rgba(11,15,25,0.08)",
    "3": "0 4px 8px rgba(11,15,25,0.06), 0 8px 24px rgba(11,15,25,0.12)",
    "4": "0 8px 16px rgba(11,15,25,0.08), 0 16px 48px rgba(11,15,25,0.16)",
    "darkAdjustment": "opacity x1.6, plus 1px solid {slate.700} border on surfaces using elevation 2-4"
  },
  "motion": {
    "duration": { "instant": 0, "micro": 80, "fast": 120, "base": 180, "moderate": 240, "slow": 320 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "reducedMotion": "all durations collapse to instant (0ms); opacity cross-fade only where a state change would otherwise be imperceptible"
  },
  "breakpoint": {
    "mobile": 0, "tablet": 768, "desktop": 1280, "wide": 1600
  },
  "grid": {
    "mobile":  { "columns": 4,  "gutter": 16, "margin": 16 },
    "tablet":  { "columns": 8,  "gutter": 24, "margin": 24 },
    "desktop": { "columns": 12, "gutter": 24, "margin": 32 },
    "wide":    { "columns": 12, "gutter": 24, "margin": 48, "contentMaxWidth": 1440 }
  },
  "zIndex": {
    "base": 0, "sticky": 10, "dropdown": 100, "overlayScrim": 200, "panel": 300,
    "modal": 400, "popover": 500, "toast": 600, "commandPalette": 700, "tooltip": 800
  },
  "sizing": {
    "touchTarget.min": 44,
    "icon": { "sm": 16, "md": 20, "lg": 24, "xl": 32 },
    "avatar": { "sm": 24, "md": 32, "lg": 40, "xl": 64 },
    "railWidth": { "collapsed": 64, "expanded": 240 },
    "panelWidth": { "sm": 400, "md": 560, "lg": 720 }
  },
  "opacity": {
    "disabled": 0.45, "hover-wash": 0.06, "active-wash": 0.10, "scrim": 0.40, "skeletonPulse": [0.6, 1]
  }
}
